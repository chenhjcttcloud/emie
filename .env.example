# 生产环境数据库配置（不要提交真实密码）
DESIGNPM_DB_HOST=127.0.0.1
DESIGNPM_DB_NAME=designpm
DESIGNPM_DB_USER=emie
DESIGNPM_DB_PASSWORD=change-me
DESIGNPM_DB_USE_SSL=true

# 测试/开发数据库配置
DESIGNPM_TEST_DB_HOST=127.0.0.1
DESIGNPM_TEST_DB_NAME=designpmtest
DESIGNPM_TEST_DB_USER=emietest
DESIGNPM_TEST_DB_PASSWORD=change-me
DESIGNPM_TEST_DB_USE_SSL=true

# 飞书全量对账（默认启动 5 分钟后首次执行，此后每小时执行；队列非空时自动跳过）
APP_FEISHU_RECONCILE_DELAY_MS=3600000
APP_FEISHU_RECONCILE_INITIAL_DELAY_MS=300000

# PPT/PPTX 在线预览（默认由 docker-compose 中的转换服务提供）
APP_PREVIEW_MAX_SOURCE_BYTES=52428800
APP_PREVIEW_MAX_CACHE_BYTES=2147483648
APP_PREVIEW_TIMEOUT_SECONDS=120
